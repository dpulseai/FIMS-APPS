{
  "name": "fims-mobile",
  "version": "1.0.4",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "postinstall": "node ./scripts/apply-patches.js && node ./eas-build-post-install.js",
    "eas-build-pre-install": "node ./eas-build-pre-install.js",
    "eas-build-post-install": "node ./eas-build-post-install.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-picker/picker": "2.9.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@supabase/supabase-js": "^2.52.1",
    "date-fns": "^3.0.6",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.1",
    "expo-camera": "~16.0.4",
    "expo-constants": "~17.0.3",
    "expo-file-system": "~18.0.4",
    "expo-font": "~13.0.1",
    "expo-image-manipulator": "~13.0.5",
    "expo-image-picker": "~16.0.2",
    "expo-location": "~18.0.2",
    "expo-modules-core": "~2.2.3",
    "expo-status-bar": "~2.0.0",
    "i18next": "^23.7.8",
    "react": "18.3.1",
    "react-i18next": "^13.5.0",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-maps": "1.18.0",
    "react-native-paper": "^5.12.3",
    "react-native-safe-area-context": "~4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-uuid": "^2.0.2",
    "react-native-vector-icons": "^10.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.3.12",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-preset-expo": "~12.0.0",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "@react-native-community/datetimepicker": "8.2.0"
  },
  "expo": {
    "install": {
      "exclude": ["@react-native-async-storage/async-storage", "@react-native-picker/picker"]
    }
  },
  "private": true
}
